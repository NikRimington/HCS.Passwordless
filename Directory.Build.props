<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <!-- CS1591: missing XML doc — kept as warning, not error, so Release packs succeed -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
    <Authors>Nik Rimington</Authors>
    <Company>Nik Rimington</Company>
    <Copyright>Copyright © Nik Rimington</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/NikRimington/HCS.Passwordless</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NikRimington/HCS.Passwordless</RepositoryUrl>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
