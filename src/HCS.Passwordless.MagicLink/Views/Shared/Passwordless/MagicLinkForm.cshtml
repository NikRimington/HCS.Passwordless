@using Microsoft.Extensions.Options
@using HCS.Passwordless.MagicLink.Configuration
@inject IOptionsMonitor<MagicLinkOptions> MlOptions
@{
    var returnUrl = Context.Request.Query["returnUrl"].FirstOrDefault() ?? string.Empty;
    if (!MlOptions.CurrentValue.Enabled) return;
}
<form id="pwl-magic-link-form"
      data-return-url="@returnUrl"
      style="max-width:400px;">

    @Html.AntiForgeryToken()

    <div style="margin-bottom:1rem;">
        <label for="pwl-email">Email address</label>
        <input id="pwl-email"
               name="email"
               type="email"
               autocomplete="username"
               required
               style="display:block;width:100%;margin-top:4px;" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
    </div>

    <button type="button" id="pwl-btn-magic-link" style="display:block;width:100%;margin-bottom:8px;">
        Email me a sign-in link
    </button>

    <div id="pwl-message" role="alert" style="margin-top:12px;"></div>
</form>
<script type="module">
    import { initMagicLinkForm } from '/App_Plugins/HCS.Passwordless/js/passwordless.js';
    initMagicLinkForm(document.getElementById('pwl-magic-link-form'));
</script>
